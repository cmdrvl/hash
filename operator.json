{
  "schema_version": "operator.v1",
  "name": "hashbytes",
  "tool_version": "0.5.1",
  "contract_version": "1.0.0",
  "description": "Computes exact byte identity (SHA-256 or BLAKE3) for artifacts in a manifest",
  "repository": "https://github.com/cmdrvl/hash",
  "license": "MIT",
  "agent_guide": "https://github.com/cmdrvl/.github/blob/main/profile/AGENT_PROMPT.md",
  "invocation": {
    "binary": "hashbytes",
    "usage": [
      "hashbytes [INPUT] [--algorithm sha256|blake3]",
      "hashbytes capabilities --json",
      "hashbytes doctor --json"
    ],
    "output_mode": "stream",
    "output_schema": "hash.v0",
    "json_flag": "--json"
  },
  "arguments": [
    {
      "name": "input",
      "type": "file_path",
      "required": false,
      "position": 0,
      "description": "JSONL manifest file (default: stdin)"
    }
  ],
  "options": [
    {
      "name": "json",
      "flag": "--json",
      "type": "boolean",
      "description": "Accepted as structured-output intent; normal hash output is already JSONL"
    },
    {
      "name": "robot-triage",
      "flag": "--robot-triage",
      "type": "boolean",
      "description": "Legacy alias for doctor triage; emit one read-only machine-readable report"
    },
    {
      "name": "algorithm",
      "flag": "--algorithm",
      "type": "string",
      "default": "sha256",
      "description": "Hash algorithm: sha256 or blake3"
    },
    {
      "name": "jobs",
      "flag": "--jobs",
      "type": "integer",
      "description": "Number of parallel workers (default: CPU count)"
    },
    {
      "name": "no-witness",
      "flag": "--no-witness",
      "type": "boolean",
      "description": "Suppress witness ledger recording"
    },
    {
      "name": "progress",
      "flag": "--progress",
      "type": "boolean",
      "description": "Emit progress to stderr"
    },
    {
      "name": "describe",
      "flag": "--describe",
      "type": "boolean",
      "description": "Print the operator.v1 contract and exit"
    },
    {
      "name": "schema",
      "flag": "--schema",
      "type": "boolean",
      "description": "Print the hash.v0 JSON Schema and exit"
    }
  ],
  "commands": [
    {
      "name": "capabilities",
      "usage": "hashbytes capabilities --json",
      "description": "Print the same operator.v1 contract as --describe",
      "read_only": true
    },
    {
      "name": "robot-docs",
      "usage": "hashbytes robot-docs guide",
      "description": "Print concise agent-facing usage notes",
      "read_only": true
    },
    {
      "name": "doctor",
      "usage": "hashbytes doctor --json",
      "description": "Read-only health, capabilities, and triage diagnostics",
      "aliases": ["doctor health", "doctor capabilities", "doctor --robot-triage"],
      "read_only": true
    },
    {
      "name": "witness",
      "usage": "hashbytes witness query --json",
      "description": "Query the witness ledger",
      "read_only": true
    }
  ],
  "exit_codes": {
    "0": {
      "meaning": "successful hash or healthy doctor report",
      "domain": "positive"
    },
    "1": {
      "meaning": "partial hash result or unhealthy doctor report",
      "domain": "unhealthy"
    },
    "2": {
      "meaning": "refusal or command-line error",
      "domain": "error"
    }
  },
  "refusals": [
    {
      "code": "E_BAD_INPUT",
      "message": "Input is not valid JSONL or missing required fields",
      "action": "escalate"
    },
    {
      "code": "E_IO",
      "message": "Cannot read input/output stream",
      "action": "escalate"
    }
  ],
  "env_vars": [
    {
      "name": "EPISTEMIC_WITNESS",
      "description": "Optional witness ledger path"
    },
    {
      "name": "NO_COLOR",
      "description": "Disable ANSI terminal styling"
    },
    {
      "name": "TERM",
      "description": "Terminal capability hint used for output styling"
    }
  ],
  "formats": [
    "hash.v0 JSONL",
    "operator.v1 JSON",
    "cmdrvl.doctor.v1 JSON"
  ],
  "side_effects": {
    "reads_files": true,
    "writes_files": false,
    "network": false,
    "writes_witness": true,
    "notes": "Hashing reads the input manifest and referenced artifacts; doctor and introspection commands are read-only."
  },
  "pipeline": {
    "upstream": ["vacuum"],
    "downstream": ["fingerprint", "lock"]
  }
}
